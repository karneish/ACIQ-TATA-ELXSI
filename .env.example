# ACIQ example configuration — ALL VALUES ARE FICTITIOUS.
# This file exists so the setup is documented. Do not put real secrets here,
# and do not commit a populated .env. Nothing in the MVP requires a credential;
# it exists so the pattern is established before it is ever needed.

# --- testbed ---
ACIQ_VENV=/home/your-user/aciq-venv
ACIQ_NS_CLIENT=client
ACIQ_NS_ROUTER=router
ACIQ_NS_WAN=wan
ACIQ_IF_LAN=veth-lan
ACIQ_IF_WAN=veth-wan

# --- shaping defaults (Mbps) ---
ACIQ_CAPACITY_MBPS=100.0
ACIQ_FLOOR_MBPS=2.0
ACIQ_FLOOR_FRACTION=0.05
ACIQ_LEASE_WEIGHT=0.4
ACIQ_LEASE_TTL_S=90
ACIQ_LEASE_LAMBDA=0.5

# --- baselines ---
ACIQ_B1_CAKE_FRACTION=0.95

# --- API (placeholder; no auth in the MVP) ---
ACIQ_API_HOST=127.0.0.1
ACIQ_API_PORT=8080
# ACIQ_API_TOKEN=not-a-real-token-use-a-placeholder-only
